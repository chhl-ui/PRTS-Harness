{
  "name": "prts-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "PRTS 受保护核心：K1 任务账本（纯 TypeScript 库，node:sqlite 存储）",
  "scripts": {
    "chat": "node src/cli/chat-main.ts",
    "chat:serve": "node src/cli/chat-serve.ts",
    "chat:remote": "node src/cli/chat-client.ts",
    "verify:e10": "node test/e10/gate.mjs",
    "verify:memory": "node --disable-warning=ExperimentalWarning scripts/verify-memory-regression.mjs",
    "secret:set": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-secret.ps1",
    "secret:del": "powershell -NoProfile -Command \"cmdkey /delete:PRTS/DeepSeek\"",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.1.0",
    "@deepseek-ai/cordis-plugin-timer": "1.2.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-observation-policy": "0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-retry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-resources": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-package-inventory-deepseek": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-log-deepseek": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-terminal": "0.2.2-rc.1",
    "@deepseek-ai/dsh-terminal-bash": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-bash-persistent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-working-directory": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-win32-process": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "js-yaml": "4.1.0",
    "koffi": "^3.3.6"
  },
  "allowScripts": {
    "koffi@3.1.1": true,
    "@deepseek-ai/dsh-subprocess-local@0.2.2-rc.1": true,
    "node-pty@1.2.0-beta.15": true
  },
  "optionalDependencies": {
    "@vscode/ripgrep-win32-x64": "1.18.0"
  }
}
